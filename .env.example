# ── baha-api environment ────────────────────────────────────────────────────
# Copy to .env and fill in. application-dev.properties has working local
# defaults, so for local dev you usually only need GOOGLE_CLIENT_ID (optional).

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# Database
CUSTOM_DB_URL=jdbc:postgresql://localhost:5432/baha
CUSTOM_DB_USER=baha_user
CUSTOM_DB_PASS=Password123!

# JWT — generate a 32+ char random secret for production
JWT_SECRET=change-me-to-a-long-random-32char-plus-secret
JWT_EXPIRATION_MS=86400000

# Google SSO — OAuth 2.0 Web client ID (same value as the UI's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# CORS — comma-separated origin patterns for the UI
BAHA_CORS_ALLOWED_ORIGINS=http://localhost:*

# Rate limits (requests/minute; 0 = unlimited)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_GOOGLE_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_REPORT_PER_MIN=20
RATE_LIMIT_RESCUE_PER_MIN=6

# Cloudflare Turnstile secret for guest (no-login) report CAPTCHA. Blank = disabled.
TURNSTILE_SECRET_KEY=

# Geofence for accepted report coordinates (Metro Manila + Rizal bbox). Set GEOFENCE_ENABLED=false to disable.
GEOFENCE_ENABLED=true
GEOFENCE_MIN_LAT=14.2
GEOFENCE_MAX_LAT=15.0
GEOFENCE_MIN_LNG=120.8
GEOFENCE_MAX_LNG=121.5
