# ── baha-api environment ────────────────────────────────────────────────────
# Copy to .env and fill in. application-dev.properties has working local
# defaults, so for local dev you usually only need GOOGLE_CLIENT_ID (optional).

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# Database
CUSTOM_DB_URL=jdbc:postgresql://localhost:5432/baha
CUSTOM_DB_USER=baha_user
CUSTOM_DB_PASS=Password123!

# JWT — generate a 32+ char random secret for production
JWT_SECRET=change-me-to-a-long-random-32char-plus-secret
JWT_EXPIRATION_MS=86400000

# Google SSO — OAuth 2.0 Web client ID (same value as the UI's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# CORS — comma-separated origin patterns for the UI
BAHA_CORS_ALLOWED_ORIGINS=http://localhost:*

# Rate limits (requests/minute; 0 = unlimited)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_GOOGLE_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_REPORT_PER_MIN=20
RATE_LIMIT_RESCUE_PER_MIN=6

# Cloudflare Turnstile secret for guest (no-login) report CAPTCHA. Blank = disabled.
TURNSTILE_SECRET_KEY=

# Geofence for accepted report coordinates (Metro Manila + Rizal bbox). Set GEOFENCE_ENABLED=false to disable.
GEOFENCE_ENABLED=true
GEOFENCE_MIN_LAT=14.2
GEOFENCE_MAX_LAT=15.0
GEOFENCE_MIN_LNG=120.8
GEOFENCE_MAX_LNG=121.5

# Public site origin — the "/?report=<id>" deep link appended to every auto-post caption.
BAHA_PUBLIC_BASE_URL=https://floodedarea.com

# ── Social auto-post ────────────────────────────────────────────────────────
# Admin/system flood reports only (FloodReportService gates on system && ADMIN); citizen
# reports are never auto-posted. Leave both switches at their safe values until the tokens
# below are verified, then flip SOCIAL_DRY_RUN first and SOCIAL_ENABLED second.
# Per-network kill switches also live in app_setting (social_autopost_facebook /
# social_autopost_x) and are toggled live from the Admin console — no restart needed.
SOCIAL_ENABLED=false
# true = log the payload and mark the row 'skipped'; nothing reaches Facebook or X.
SOCIAL_DRY_RUN=true
# Retries per row before a failure sticks as 'failed' (Admin console can still Retry).
SOCIAL_MAX_ATTEMPTS=3
# PUBLIC base URL of THIS API (not the site) — Facebook fetches the report photo from
# <SOCIAL_API_BASE_URL><photoUrl>, so Facebook posts permanently fail while this is blank.
# In the standard deploy nginx serves the API under /api/ on the site domain.
SOCIAL_API_BASE_URL=https://floodedarea.com/api

# Facebook — numeric Page id, plus a LONG-LIVED Page access token carrying
# pages_manage_posts + pages_read_engagement. A short-lived token expires in ~1 hour.
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v21.0

# X — consumer key/secret from the developer app, and an access token/secret for the
# posting account. The app's user-authentication settings must grant "Read and Write";
# a read-only token fails every post with a 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
